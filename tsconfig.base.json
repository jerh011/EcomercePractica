{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["apps/admin-web/src/app/shared/*"],
      "@core/*": ["apps/admin-web/src/app/core/*"],
      "@environments/*": ["apps/admin-web/src/environments/*"],
      "@catalogs/*": ["apps/admin-web/src/app/features/catalogs/*"],
      "@categories/*": ["apps/admin-web/src/app/features/categories/*"]
    }
  }
}
