{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "paths": {
    
      "@ecomercepractica/db": ["libs/db/src/index.ts"],
      "@ecomercepractica/shared/*": ["libs/shared/*"],    
      "@shared/*": ["apps/admin-web/src/app/shared/*"],
      "@core/*": ["apps/admin-web/src/app/core/*"],
      "@environments/*": ["apps/admin-web/src/environments/*"],
      "@catalogs/*": ["apps/admin-web/src/app/features/catalogs/*"],
      "@categories/*": ["apps/admin-web/src/app/features/categories/*"],
      "@attributes/*": ["apps/admin-web/src/app/features/attributes/*"],
      "@products/*": ["apps/admin-web/src/app/features/products/*"],
      "@brands/*": ["apps/admin-web/src/app/features/brands/*"],
      "@ecomercepractica/shared/validations/*": ["libs/shared/validations/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
