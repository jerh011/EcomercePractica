{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "paths": {
      "@ecomercepractica/shared/contracts/*": ["libs/shared/contracts/*"],
      "@ecomercepractica/db": ["libs/db/src/index.ts"],
      "@ecomercepractica/shared/*": ["libs/shared/*"],
      "@shared/*": ["apps/admin-web/src/app/shared/*"],
      "@core/*": ["apps/admin-web/src/app/core/*"],
      "@environments/*": ["apps/admin-web/src/environments/*"],
      "@catalogs/*": ["apps/admin-web/src/app/features/catalogs/*"],
      "@categories/*": ["apps/admin-web/src/app/features/categories/*"],
      "@ecomercepractica/shared/contracts": [
        "libs/shared/contracts/src/index.ts"
      ],
      "@ecomercepractica/shared/validations": [
        "libs/shared/validations/index.ts"
      ],
      "@ecomercepractica/shared/validations/*": ["libs/shared/validations/*"]
      // "@org/shared-ui": ["./libs/shared-ui/src/index.ts"],
      // "@org/db": ["./libs/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
