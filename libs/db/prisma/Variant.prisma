model Variant {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                  @map("product_id") @db.Uuid
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @db.VarChar(32)
  price           Decimal?                @db.Decimal(12, 2)
  minimumStock    Int                     @default(0) @map("minimum_stock")
  barcodeGtin     String?                 @map("barcode_gtin") @db.VarChar(14)
  descriptionHtml String?                 @map("description_html")
  offerPrice      Decimal?                @map("offer_price") @db.Decimal(12, 2)
  offerStart      DateTime?               @map("offer_start") @db.Timestamptz
  offerEnd        DateTime?               @map("offer_end") @db.Timestamptz
  dimensions      Json?
  isActive        Boolean                 @default(true) @map("is_active")
  imageUrls       String[]                @default([]) @map("images_urls")
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  attributeLinks  VariantAttribute[]
  attributeValues VariantAttributeValue[]
  inventoryAllocations InventoryAllocation[]
  inventoryMovements InventoryMovement[]
  orderItems      OrderItem[]

  @@index([productId])
  @@map("variants")
}