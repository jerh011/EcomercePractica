model Payment {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String         @unique @map("order_id") @db.Uuid
  methodId              Int            @map("method_id")
  statusId              Int            @map("status_id")
  transactionExternalId String?        @map("transaction_external_id")
  amount                Decimal        @db.Decimal(12, 2)
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method                PaymentMethod  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  status                PaymentStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  @@index([methodId])
  @@index([statusId])
  @@map("payments")
}
